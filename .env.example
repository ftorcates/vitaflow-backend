# demo funciona sin credenciales. hybrid usa GLM y recurre a Luna ante errores.
VITAFLOW_AI_MODE=demo
ZAI_API_KEY=
ZAI_MODEL=glm-4.6v-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Orígenes web permitidos, separados por coma. La app Android no usa CORS.
VITAFLOW_ALLOWED_ORIGINS=http://localhost:3000
VITAFLOW_MAX_IMAGE_MB=8
VITAFLOW_RATE_LIMIT_PER_MINUTE=30
# Opcional en desarrollo local. Si lo activas, configura el mismo valor en local.properties.
VITAFLOW_CLIENT_TOKEN=
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
